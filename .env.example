# Copy to .env (never commit .env) or export in your shell.
# Alternatively run `ant auth login` once - then no key is needed here.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Workspace-ID for the Console link (default: "default")
# ANTHROPIC_WORKSPACE=default

# Optional: override the IDs from claude-lock.json
# AGENT_ID=agent_...
# ENVIRONMENT_ID=env_...
